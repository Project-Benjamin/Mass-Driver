[Main]
SetupWizardIncomplete = false
StartPaused = false
EmulationSpeed = 1

[AutoUpdater]
CheckAtStartup = false

[BIOS]
SearchDirectory = @BIOS_DIRECTORY@
PathNTSCU = ps-22a.bin
PatchFastBoot = true

[GPU]
Renderer = D3D11
ResolutionScale = 1

[Folders]
Cache = @DATA_DIRECTORY@/cache
Cheats = @DATA_DIRECTORY@/cheats
Covers = @DATA_DIRECTORY@/covers
GameIcons = @DATA_DIRECTORY@/gameicons
GameSettings = @DATA_DIRECTORY@/gamesettings
InputProfiles = @DATA_DIRECTORY@/inputprofiles
Patches = @DATA_DIRECTORY@/patches
SaveStates = @DATA_DIRECTORY@/savestates
Screenshots = @DATA_DIRECTORY@/screenshots
Shaders = @DATA_DIRECTORY@/shaders
Subchannels = @DATA_DIRECTORY@/subchannels
Textures = @DATA_DIRECTORY@/textures
Videos = @DATA_DIRECTORY@/videos

[MemoryCards]
Card1Type = PerGameTitle
Card2Type = None
Directory = @DATA_DIRECTORY@/memcards
UsePlaylistTitle = true

[InputSources]
SDL = true
SDLControllerEnhancedMode = false
SDLPS5PlayerLED = false
XInput = false
RawInput = false

[Pad1]
Type = AnalogController
Up = Keyboard/UpArrow
Up = SDL-0/DPadUp
Up = SDL-0/-LeftY
Down = Keyboard/DownArrow
Down = SDL-0/DPadDown
Down = SDL-0/+LeftY
Left = Keyboard/LeftArrow
Left = SDL-0/DPadLeft
Left = SDL-0/-LeftX
Right = Keyboard/RightArrow
Right = SDL-0/DPadRight
Right = SDL-0/+LeftX
Cross = Keyboard/K
Cross = SDL-0/A
Circle = Keyboard/L
Circle = SDL-0/B
Square = Keyboard/J
Square = SDL-0/X
Triangle = Keyboard/I
Triangle = SDL-0/Y
Start = Keyboard/Enter
Start = SDL-0/Start
Select = Keyboard/Backspace
Select = SDL-0/Back
L1 = Keyboard/Q
L1 = SDL-0/LeftShoulder
R1 = Keyboard/E
R1 = SDL-0/RightShoulder
L2 = Keyboard/1
L2 = SDL-0/+LeftTrigger
R2 = Keyboard/3
R2 = SDL-0/+RightTrigger
LUp = SDL-0/-LeftY
LDown = SDL-0/+LeftY
LLeft = SDL-0/-LeftX
LRight = SDL-0/+LeftX
RUp = SDL-0/-RightY
RDown = SDL-0/+RightY
RLeft = SDL-0/-RightX
RRight = SDL-0/+RightX

[Pad2]
Type = None

[Hotkeys]
TogglePause = Keyboard/Space
OpenPauseMenu = Keyboard/Escape
ToggleFullscreen = Keyboard/F11
